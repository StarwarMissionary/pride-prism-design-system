{
  "manifest_version": 3,
  "name": "Pride Prism",
  "version": "1.0.0",
  "description": "A polished Pride theme with a deep-violet workspace and Progress Pride accents.",
  "theme": {
    "images": {
      "theme_frame": "images/theme_frame.png",
      "theme_toolbar": "images/theme_toolbar.png",
      "theme_ntp_background": "images/theme_ntp_background.png"
    },
    "colors": {
      "frame": [117, 7, 135],
      "frame_inactive": [36, 16, 58],
      "toolbar": [20, 0, 33],
      "toolbar_text": [255, 249, 242],
      "tab_text": [255, 255, 255],
      "tab_background_text": [255, 255, 255],
      "bookmark_text": [255, 249, 242],
      "ntp_background": [20, 0, 33],
      "ntp_text": [255, 249, 242],
      "ntp_link": [116, 215, 238],
      "button_background": [255, 79, 216]
    },
    "tints": {
      "buttons": [0.88, 0.62, 0.72]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat"
    }
  }
}
