{
  "manifest_version": 3,
  "name": "Pride Prism",
  "version": "1.0.0",
  "description": "A dark, neutral workspace with a locally chosen Pride Prism palette.",
  "theme": {
    "colors": {
      "frame": [30, 26, 36],
      "frame_inactive": [20, 17, 24],
      "toolbar": [20, 17, 24],
      "toolbar_text": [246, 241, 248],
      "tab_text": [246, 241, 248],
      "tab_background_text": [201, 191, 210],
      "bookmark_text": [246, 241, 248],
      "ntp_background": [20, 17, 24],
      "ntp_text": [246, 241, 248],
      "ntp_link": [166, 200, 255],
      "button_background": [42, 36, 51]
    },
    "tints": {
      "buttons": [-1, 0, 0.8]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat"
    }
  }
}
