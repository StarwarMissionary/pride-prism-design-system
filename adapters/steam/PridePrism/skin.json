{
  "name": "Pride Prism",
  "author": "StarwarMissionary",
  "description": "A dark, professional Progress Pride theme with restrained motion.",
  "github": {
    "owner": "StarwarMissionary",
    "repo_name": "pride-prism-design-system"
  },
  "header_image": "https://starwarmissionary.github.io/pride-prism-design-system/assets/pride-prism-og.png",
  "splash_image": "https://starwarmissionary.github.io/pride-prism-design-system/assets/pride-prism-og.png",
  "tags": [
    "Dark",
    "Colorful",
    "Pride",
    "Accessibility"
  ],
  "version": "1.0.2",
  "Patches": [
    {
      "MatchRegexString": "^https:\\/\\/store\\.steampowered\\.com\\/.*",
      "TargetCss": "webkit.css"
    },
    {
      "MatchRegexString": "^https:\\/\\/steamcommunity\\.com\\/.*",
      "TargetCss": "webkit.css"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetCss": "libraryroot.custom.css"
    },
    {
      "MatchRegexString": ".*",
      "TargetCss": "libraryroot.custom.css"
    }
  ]
}
