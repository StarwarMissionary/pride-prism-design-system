<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="PrismRed">#E40303</Color>
  <Color x:Key="PrismOrange">#FF8C00</Color>
  <Color x:Key="PrismYellow">#FFED00</Color>
  <Color x:Key="PrismGreen">#008026</Color>
  <Color x:Key="PrismBlue">#004DFF</Color>
  <Color x:Key="PrismViolet">#750787</Color>
  <Color x:Key="PrismTransBlue">#74D7EE</Color>
  <Color x:Key="PrismTransPink">#FFAFC8</Color>
  <Color x:Key="PrismSurface">#140021</Color>
  <Color x:Key="PrismSurfaceRaised">#24103A</Color>
  <Color x:Key="PrismForeground">#FFF9F2</Color>
  <Color x:Key="PrismAccent">#FF4FD8</Color>

  <SolidColorBrush x:Key="PrismSurfaceBrush" Color="{StaticResource PrismSurface}" />
  <SolidColorBrush x:Key="PrismSurfaceRaisedBrush" Color="{StaticResource PrismSurfaceRaised}" />
  <SolidColorBrush x:Key="PrismForegroundBrush" Color="{StaticResource PrismForeground}" />
  <SolidColorBrush x:Key="PrismAccentBrush" Color="{StaticResource PrismAccent}" />

  <LinearGradientBrush x:Key="PrismClassicGradient" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="{StaticResource PrismRed}" Offset="0" />
    <GradientStop Color="{StaticResource PrismOrange}" Offset="0.2" />
    <GradientStop Color="{StaticResource PrismYellow}" Offset="0.4" />
    <GradientStop Color="{StaticResource PrismGreen}" Offset="0.6" />
    <GradientStop Color="{StaticResource PrismBlue}" Offset="0.8" />
    <GradientStop Color="{StaticResource PrismViolet}" Offset="1" />
  </LinearGradientBrush>

  <CornerRadius x:Key="PrismRadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="PrismRadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="PrismRadiusLarge">18</CornerRadius>
  <Duration x:Key="PrismMotionFast">0:0:0.160</Duration>
  <Duration x:Key="PrismMotionStandard">0:0:0.280</Duration>
  <Duration x:Key="PrismMotionGradient">0:0:1.200</Duration>
</ResourceDictionary>
